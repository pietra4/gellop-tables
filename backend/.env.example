# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://clayite:clayite_pass@localhost:5432/clayite

# JWT
JWT_SECRET=change-me-to-a-real-secret-in-production
JWT_EXPIRES_IN=7d

# Redis (optional, used by pg-boss for enrichment queue)
REDIS_URL=redis://localhost:6379/0

# Enrichment
ENRICHMENT_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173
